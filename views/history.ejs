<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>History</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 min-h-screen text-slate-900">

    <!-- Navbar -->
    <nav class="bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">

            <h1 class="text-xl font-bold tracking-tight">
                Calorie<span class="text-emerald-600">Tracker</span>
            </h1>

            <div class="flex gap-6 text-sm font-medium">

                <a href="/" class="text-slate-500 hover:text-slate-900">
                    Home
                </a>

                <a href="/history" class="text-emerald-600">
                    History
                </a>

            </div>

        </div>
    </nav>


    <main class="max-w-5xl mx-auto px-6 py-10">

        <!-- Header -->
        <div class="mb-8 flex justify-between items-end">

            <div>

                <p class="text-sm font-semibold text-emerald-600 uppercase tracking-wider mb-2">
                    Nutrition Log
                </p>

                <h2 class="text-4xl font-bold tracking-tight">
                    Food History
                </h2>

                <p class="text-slate-500 mt-2">
                    See your meals and nutrition from previous days.
                </p>

            </div>


            <!-- Opens Modal -->
            <button
                id="openModal"
                type="button"
                class="bg-red-50 text-red-600 border border-red-100 px-4 py-2 rounded-lg font-medium hover:bg-red-100 transition"
            >
                Clear History
            </button>

        </div>


        <!-- No history -->
        <% if (Object.keys(groupedFoods).length === 0) { %>

            <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">

                <p class="text-slate-400">
                    No food history yet.
                </p>

            </div>


        <!-- History exists -->
        <% } else { %>

            <div class="space-y-6">

                <% for (let date in groupedFoods) { %>

                    <%
                        let totalCalories = 0;
                        let totalProtein = 0;

                        for (let i = 0; i < groupedFoods[date].length; i++) {
                            totalCalories += Number(groupedFoods[date][i].calories);
                            totalProtein += Number(groupedFoods[date][i].protein);
                        }
                    %>


                    <!-- Day Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

                        <!-- Date Header -->
                        <div class="bg-emerald-50 px-6 py-5 flex justify-between items-center border-b border-emerald-100">

                            <div>

                                <p class="text-xs uppercase tracking-wider font-semibold text-emerald-600">
                                    Daily Summary
                                </p>

                                <h3 class="text-xl font-bold text-slate-900 mt-1">
                                    <%= date %>
                                </h3>

                            </div>


                            <!-- Daily totals -->
                            <div class="flex gap-3">

                                <span class="bg-white px-4 py-2 rounded-full text-sm font-semibold text-orange-600 border border-orange-100 shadow-sm">
                                    <%= totalCalories %> kcal
                                </span>

                                <span class="bg-white px-4 py-2 rounded-full text-sm font-semibold text-blue-600 border border-blue-100 shadow-sm">
                                    <%= totalProtein %>g protein
                                </span>

                            </div>

                        </div>


                        <!-- Foods -->
                        <div class="divide-y divide-slate-100">

                            <% for (let i = 0; i < groupedFoods[date].length; i++) { %>

                                <div class="px-6 py-5 flex justify-between items-center hover:bg-slate-50 transition">

                                    <!-- Food name -->
                                    <div>

                                        <h4 class="text-base font-semibold text-slate-900">
                                            <%= groupedFoods[date][i].food %>
                                        </h4>

                                        <p class="text-xs text-slate-400 mt-1">
                                            Food entry
                                        </p>

                                    </div>


                                    <!-- Nutrition -->
                                    <div class="flex gap-3">

                                        <span class="bg-orange-50 text-orange-700 px-3 py-1.5 rounded-lg text-sm font-medium">
                                            <%= groupedFoods[date][i].calories %> kcal
                                        </span>

                                        <span class="bg-blue-50 text-blue-700 px-3 py-1.5 rounded-lg text-sm font-medium">
                                            <%= groupedFoods[date][i].protein %>g protein
                                        </span>

                                    </div>

                                </div>

                            <% } %>

                        </div>

                    </div>

                <% } %>

            </div>

        <% } %>

    </main>


    <!-- Clear History Modal -->
    <div
        id="clearModal"
        class="hidden fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center"
    >

        <!-- Modal Box -->
        <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl">

            <h2 class="text-xl font-bold text-slate-900">
                Clear History?
            </h2>

            <p class="text-slate-500 mt-2">
                This will permanently delete all of your food entries.
            </p>


            <div class="flex justify-end gap-3 mt-6">

                <!-- Cancel -->
                <button
                    id="closeModal"
                    type="button"
                    class="px-4 py-2 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50"
                >
                    Cancel
                </button>


                <!-- Actually Delete -->
                <form action="/history/clear" method="POST">

                    <button
                        type="submit"
                        class="px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700"
                    >
                        Clear History
                    </button>

                </form>

            </div>

        </div>

    </div>

    <script>

        const openModal = document.getElementById("openModal");
        const closeModal = document.getElementById("closeModal");
        const clearModal = document.getElementById("clearModal");

        // if openmodal was clicked, remove fixed
        openModal.addEventListener("click", () => {
            clearModal.classList.remove("hidden");
        });

        closeModal.addEventListener("click", () => {
            clearModal.classList.add("hidden");
        });

    </script>

</body>

</html>